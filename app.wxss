page {
  background-color: #f7f7f9;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, sans-serif;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #ff6b6b;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary::after {
  border: none;
}

.text-muted {
  color: #999999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #bbbbbb;
}

.empty .icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}
