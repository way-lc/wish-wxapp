.login-card {
  text-align: center;
  padding: 120rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.login-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 48rpx;
}

.login-btn {
  width: 80%;
  margin: 0 auto;
}

.profile-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffecec;
  color: #ff6b6b;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
}

.profile-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.profile-count {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.logout-btn {
  background: #f7f7f9;
  color: #666666;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
  line-height: 64rpx;
  height: 64rpx;
  margin: 0;
}

.logout-btn::after {
  border: none;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin: 12rpx 0 20rpx;
}

.wish-card {
  transition: transform 0.15s;
}

.wish-card:active {
  transform: scale(0.98);
}

.wish-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.wish-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  margin-right: 16rpx;
}

.wish-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.wish-status.open {
  background: #fff0e6;
  color: #ff8c42;
}

.wish-status.done {
  background: #e8f5e9;
  color: #4caf50;
}

.wish-footer {
  display: flex;
  align-items: center;
}

.wish-tag {
  font-size: 22rpx;
  color: #ff6b6b;
  background: #ffecec;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 12rpx;
}

.wish-budget {
  font-size: 24rpx;
  color: #ff6b6b;
  font-weight: 600;
}

.go-publish {
  width: 40%;
  margin: 32rpx auto 0;
}

.diary-section-title {
  margin-top: 40rpx;
}

.diary-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform 0.15s;
}

.diary-entry:active {
  transform: scale(0.98);
}

.diary-entry-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.diary-entry-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.diary-entry-info {
  display: flex;
  flex-direction: column;
}

.diary-entry-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.diary-entry-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.diary-entry-arrow {
  font-size: 40rpx;
  color: #cccccc;
}
